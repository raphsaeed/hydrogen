# Hydrogen Local Configuration (.env.example)
# Copy to `.env` (which is git-ignored) and adjust values for your machine.

# Passphrase ("Lesson Key") used to create/unlock local L7 `.raphs` vaults
HYDROGEN_LESSON_KEY=gyara-local-dev-lesson-key-2026

# Logical HLC device identifier stamped onto vault rows
HYDROGEN_DEVICE_ID=hydrogen-dgx-spark

# Carbon WebSocket endpoint (`ws://127.0.0.1:7420/carbon` locally or `ws://<mac-ip>:7420/carbon` over LAN)
CARBON_WS_URL=ws://127.0.0.1:7420/carbon

# Local HTTP/WebSocket bind address for Hydrogen Web Console (Phase 4)
HYDROGEN_BIND_ADDR=127.0.0.1:7430

# Gemini 4 API Key (required starting in Phase 3 for native Rust API batch compilation)
GEMINI_API_KEY=
